<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.dan.defaultToMacMic</string>

    <key>ProgramArguments</key>
    <array>
      <string>/Your/Compiled/Script/Path</string>
    </array>

    <key>StartInterval</key>
    <integer>30</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/micfix.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/micfix.err</string>
  </dict>
</plist>